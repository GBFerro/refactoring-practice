{
  "name": "refactoring-practice",
  "version": "0.1.0",
  "private": true,
  "description": "Hands-on TypeScript exercises for Martin Fowler's Refactoring (2nd ed.)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:solutions": "SOLUTIONS=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:strict": "oxlint -c .oxlintrc.strict.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "rp": "tsx scripts/rp.ts",
    "check": "tsx scripts/rp.ts check"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
